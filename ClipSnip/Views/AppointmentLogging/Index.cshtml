@{
}

<input type="hidden" id="customInput" data-value="@ViewBag.CustomValue" />

<div id="appointmentForm">
    <label>Hairsyle:</label><br>
    <select name="hairstyles" id="hairstyle">
        @foreach(string op in ViewBag.hairstyles)
        {
            <option value="@op">@op</option>
        }
    </select><br />
    <label>Duration in minutes:</label><br>
    <input type="number" id="durationInMinutes" name="durationInMinutes" value="20"><br>
    <label>Date:</label><br>
    <input type="date" id="dateOfAppointment" name="dateOfAppointment">
    <br><br>
    <input type="submit" id="submitButton" value="Submit">
</div> 

@section Scripts {
    <script type="module" src="~/js/appointmentlogging.js"></script>
}