@{
}

<div class="container mt-4"> <div class="row justify-content-center"> <div class="col-md-8 col-lg-6"> <div class="card shadow-sm"> 
    <div class="card-header bg-primary text-white"> 
        <h4 class="mb-0">Average Hairstyle Times</h4> 
    </div> 
    <div class="card-body p-0"> <div class="table-responsive"> 
        <table class="table table-striped table-hover mb-0"> <thead class="table-light"> <tr> 
            <th scope="col">Hairstyle</th> <th scope="col">Average Time (minutes)</th> </tr> </thead> 
            <tbody> 
                @foreach(var item in ViewBag.avarageTimes) 
                {
                    <tr> <td>@item.hairstyle</td> <td>@item.duration</td> </tr>
                }
            </tbody> 
        </table> </div> </div> </div> </div> </div> 
</div>