@{
    ViewData["Title"] = "Find Your Style";
}

<section class="landing-page">
    <canvas id="hero-canvas" aria-hidden="true"></canvas>

    <div class="landing-content">
        <p class="eyebrow">CLIPSNIP</p>

        <h1>Find a hairstyle that feels like you.</h1>

        <p class="landing-description">
            Upload a photo and discover hairstyle recommendations tailored to your face shape.
        </p>

        <div class="landing-actions">
            <a class="btn btn-primary btn-lg"
               asp-controller="HairstyleFinder"
               asp-action="Index">
                Find my hairstyle
            </a>

            <a class="btn btn-outline-light btn-lg" href="#about">
                Learn more
            </a>
        </div>
    </div>
</section>

<section id="about" class="landing-about">
    <h2>Personalized recommendations</h2>
    <p>
        ClipSnip combines image analysis and hairstyle data to help you explore your next look.
    </p>
</section>

@section Scripts {
    <script type="module" src="~/js/landing.js" asp-append-version="true"></script>

}