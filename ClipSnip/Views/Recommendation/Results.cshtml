@model List<ClipSnip.Models.Hairstyle>

@{
    ViewData["Title"] = "Recommendation Results";
}

<h1>Recommendation Results</h1>
<hr />
<h2>Detected Face Shape</h2>
<h3>@ViewBag.FaceShape</h3>
<h4>Why?</h4>
<ul>
    @foreach (var reason in ViewBag.FaceShapeReasons)
    {
        <li>@reason</li>
    }
</ul>

<hr />

<h2>Recommended Hairstyles</h2>

@foreach (var hairstyle in Model)
{
    <div class="card mb-3">
        <div class="card-body">

            <h3>@hairstyle.Name</h3>

            <p>@hairstyle.Description</p>

        </div>
    </div>
}

<a asp-controller="Recommendation"
   asp-action="Index"
   class="btn btn-secondary">
    Back
</a>